# =====================================================
#  微信读书 掌机版 —— 手柄映射 v6
#
#  ⚠️ 必须配合 SDL_GAMECONTROLLERCONFIG_FILE 才生效
#     （方向键走 hat 直通；按钮走 SDL 名字）
#     node.sh 已把它指向【ES 那份】db（A/B 与硬件一致）
#
#  ⚠️ SELECT（SDL 名 back）必须显式映射为 F9，否则会被默认当成 Esc
#     触发网页返回。START+SELECT 仍是内建退出组合。
# =====================================================

# 十字键 = 方向键（阅读器内=翻页；书架/首页=移动焦点；长按连发）
up    = up
down  = down
left  = left
right = right

# 左摇杆 = 评论划线选择器（阅读器内：上/左选上一条，下/右选下一条）
left_analog_up = insert
left_analog_left = insert
left_analog_down = delete
left_analog_right = delete

# A = 确定    B = 返回
a     = enter
b     = esc

# X = 目录    Y = 空格
x     = tab
y     = space

# L1/R1 = 上一页 / 下一页
l1    = pageup
r1    = pagedown

# L2/R2 = 页首 / 页尾（阅读器内由扩展映射为上一页 / 下一页）
l2 = home
r2 = end

# ⭐ START = 掌机菜单（目录 / 设置 / 搜索 / 上一页 / 书架 / 退出）
#    START 映射为 F10；START+SELECT 仍由 gptokeyb 内建组合退出。
start = f10

# SELECT = 退出提示（START+SELECT 仍由 gptokeyb 内建组合退出）
back   = f9
